{
  "manifest_version": 3,
  "name": "五邑大学自动评教助手",
  "version": "3.0.0",
  "description": "自动完成五邑大学教务系统的课程评教",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.wyu.edu.cn/*",
    "*://jwgl.wyu.edu.cn/*",
    "*://jxgl.wyu.edu.cn/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.wyu.edu.cn/*",
        "*://jwgl.wyu.edu.cn/*",
        "*://jxgl.wyu.edu.cn/*"
      ],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["*://*.wyu.edu.cn/*", "*://jwgl.wyu.edu.cn/*", "*://jxgl.wyu.edu.cn/*"]
    }
  ]
}
